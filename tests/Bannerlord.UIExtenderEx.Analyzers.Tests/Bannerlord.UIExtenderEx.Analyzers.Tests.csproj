<!--EXTERNAL_PROPERTIES: GameVersion;AnalyzerRoslynVersion-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net472 is what Visual Studio runs analyzers on; net6.0 is what the dotnet CLI does -->
    <TargetFrameworks>net472;net6.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="nunit" Version="3.14.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.6.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(AnalyzerRoslynVersion)" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="$(AnalyzerRoslynVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bannerlord.UIExtenderEx.Analyzers\Bannerlord.UIExtenderEx.Analyzers.csproj" />
    <ProjectReference Include="..\..\src\Bannerlord.UIExtenderEx.Analyzers.CodeFixes\Bannerlord.UIExtenderEx.Analyzers.CodeFixes.csproj" />
    <!-- Not used by the tests' own code: its output is a reference of the code the tests compile -->
    <ProjectReference Include="..\..\src\Bannerlord.UIExtenderEx\Bannerlord.UIExtenderEx.csproj" />
  </ItemGroup>

  <!--
  The analyzer targets, for TargetsTests to run through MSBuild as a mod's build would, with the task assembly and
  FetchBannerlordVersion's next to them, as the package lays them out
  -->
  <ItemGroup>
    <None Include="..\..\src\Bannerlord.UIExtenderEx.Analyzers\build\Bannerlord.UIExtenderEx.Analyzers.targets" Link="Packaging\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="..\..\src\Bannerlord.UIExtenderEx.Analyzers.Tasks\Bannerlord.UIExtenderEx.Analyzers.Tasks.csproj" />
  </ItemGroup>
  <Target Name="_CopyAnalyzerTasksNextToTheTargets" AfterTargets="CopyFilesToOutputDirectory">
    <Copy SourceFiles="$(OutDir)Bannerlord.UIExtenderEx.Analyzers.Tasks.dll;$(OutDir)FetchBannerlordVersion.Source.dll" DestinationFolder="$(OutDir)Packaging" SkipUnchangedFiles="true" />
  </Target>

  <!--
  What the code under test compiles against, copied next to the tests: .NET Framework 4.7.2 as the game's modules
  target it, and the game's reference assemblies. From packages rather than a game install, so the tests run anywhere.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" IncludeAssets="none" GeneratePathProperty="true" />
    <PackageReference Include="Bannerlord.ReferenceAssemblies.Core" Version="$(GameVersion).*" PrivateAssets="all" IncludeAssets="none" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net472)\build\.NETFramework\v4.7.2\mscorlib.dll;$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net472)\build\.NETFramework\v4.7.2\System.dll;$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net472)\build\.NETFramework\v4.7.2\System.Core.dll;$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net472)\build\.NETFramework\v4.7.2\System.Xml.dll;$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net472)\build\.NETFramework\v4.7.2\System.Numerics.dll;$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net472)\build\.NETFramework\v4.7.2\Facades\netstandard.dll;$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net472)\build\.NETFramework\v4.7.2\Facades\System.Runtime.dll"
          Link="References\Framework\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(PkgBannerlord_ReferenceAssemblies_Core)\ref\netstandard2.0\TaleWorlds.*.dll"
          Link="References\Game\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <!--
    The game's System.Numerics.Vectors, 4.1.3.0, which a mod compiles against with the game. Overload resolution of a
    widget's OnPropertyChanged needs it: one of the nine overloads takes a Vector2, which this build forwards to the
    framework's System.Numerics (above). Downloaded rather than referenced, so the 4.5.0 the rest of the project resolves
    is left alone.
    -->
    <None Include="$([MSBuild]::EnsureTrailingSlash('$(NuGetPackageRoot)'))system.numerics.vectors\4.4.0\ref\net46\System.Numerics.Vectors.dll"
          Link="References\Game\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageDownload Include="System.Numerics.Vectors" Version="[4.4.0]" />
  </ItemGroup>

</Project>
