<!--EXTERNAL_PROPERTIES: AnalyzerRoslynVersion-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <RootNamespace>Bannerlord.UIExtenderEx.Analyzers</RootNamespace>
  </PropertyGroup>

  <!--NuGet Package-->
  <!--
  A package of its own rather than part of Bannerlord.UIExtenderEx: many mods reference that one with
  IncludeAssets="compile", which leaves analyzers out, and new warnings arriving with an update would fail every build
  that treats warnings as errors. See docs/design-records/build-time-checks.md.
  -->
  <PropertyGroup>
    <PackageId>Bannerlord.UIExtenderEx.Analyzers</PackageId>
    <PackageDescription>Build-time checks for UIExtenderEx ViewModel mixins and prefab XML: members that replace the game's, names two mixins both add, refresh methods that do not exist, mixins that can never run or cannot be created, widget attributes that do not exist or cannot be converted, and bindings to members the ViewModel does not have. With code fixes for most of them.</PackageDescription>
    <Title>UIExtenderEx Analyzers</Title>
    <Authors>BUTR</Authors>
    <DevelopmentDependency>true</DevelopmentDependency>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <PackageIcon>Butter.png</PackageIcon>
    <PackageTags>bannerlord uiextenderex analyzers</PackageTags>
    <!-- The analyzer goes into analyzers/dotnet/cs, not lib/, and carries no dependencies into the mod -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- Nothing in lib/ means no symbols to put into a snupkg -->
    <IncludeSymbols>false</IncludeSymbols>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../resources/Butter.png" Pack="true" PackagePath="" />
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="build\Bannerlord.UIExtenderEx.Analyzers.targets" Pack="true" PackagePath="build" />
  </ItemGroup>
  <!--
  The code fixes go next to the analyzer. Built first, and not referenced: the analyzer must not load the Workspaces
  layer they need.
  -->
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddCodeFixesToPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bannerlord.UIExtenderEx.Analyzers.CodeFixes\Bannerlord.UIExtenderEx.Analyzers.CodeFixes.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="_AddCodeFixesToPackage">
    <MSBuild Projects="..\Bannerlord.UIExtenderEx.Analyzers.CodeFixes\Bannerlord.UIExtenderEx.Analyzers.CodeFixes.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="_CodeFixesAssembly" />
    </MSBuild>
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_CodeFixesAssembly)" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>
  <!--NuGet Package-->

  <ItemGroup>
    <!--
    The oldest compiler the analyzer has to load in, not the newest: an analyzer built against a newer Roslyn fails to
    load in an older compiler. 4.8 is the .NET 8 SDK and Visual Studio 2022 17.8.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(AnalyzerRoslynVersion)" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

</Project>
